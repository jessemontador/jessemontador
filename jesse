<style>
:root{
  --primary:#ff8c00;
  --secondary:#1d4ed8;
  --dark:#0f172a;
  --bg:#f8fafc;
  --card:#ffffff;
  --text:#1e293b;
  --success:#25D366;
}
*{box-sizing:border-box}
body{margin:0;font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;background:var(--bg);color:var(--text);line-height:1.6}
.container{max-width:1100px;margin:auto;padding:0 20px}

/* Header & Hero */
header{
  background:linear-gradient(135deg,var(--dark),var(--secondary));
  color:#fff;padding:80px 20px;text-align:center;
}
.logo{font-size:2.5rem;font-weight:900;letter-spacing:-1px}
.logo span{color:var(--primary)}
.badge{
  display:inline-block;background:var(--success);color:#fff;
  padding:8px 16px;border-radius:999px;font-size:14px;margin-bottom:20px;font-weight:bold
}
h1{font-size:2.8rem;margin:15px 0;line-height:1.2}
.hero p{font-size:1.2rem;max-width:750px;margin:0 auto 30px;opacity:0.9}

/* Botões */
.btn{
  display:inline-block;padding:16px 32px;border-radius:12px;
  text-decoration:none;font-weight:bold;transition:.3s;font-size:1.1rem
}
.btn-whats{background:var(--success);color:#fff;box-shadow: 0 4px 15px rgba(37, 211, 102, 0.3)}
.btn-whats:hover{transform:translateY(-3px);box-shadow: 0 6px 20px rgba(37, 211, 102, 0.4)}

/* Stats */
.stats{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(200px,1fr));
  gap:20px;margin-top:-40px;position:relative;z-index:10
}
.stat{
  background:#fff;padding:25px;border-radius:16px;text-align:center;
  box-shadow:0 10px 25px rgba(0,0,0,0.1);font-weight:bold;border-bottom:4px solid var(--primary)
}

/* Sections */
.section{padding:80px 0}
.section-title{
  text-align:center;font-size:2.2rem;color:var(--dark);margin-bottom:45px;position:relative
}
.section-title::after{
  content:'';display:block;width:60px;height:4px;background:var(--primary);margin:10px auto;border-radius:2px
}

/* Cards de Serviços e Produtos */
.cards{
  display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:25px
}
.card{
  background:var(--card);padding:35px 25px;border-radius:20px;
  box-shadow:0 5px 15px rgba(0,0,0,0.05);text-align:center;transition:.3s;border:1px solid #e2e8f0
}
.card:hover{transform:translateY(-5px);border-color:var(--primary)}
.card i{font-size:3.5rem;color:var(--primary);margin-bottom:20px}
.card h3{margin:10px 0;font-size:1.4rem}
.card a{
  display:block;background:var(--secondary);color:#fff;text-decoration:none;
  padding:14px;border-radius:10px;margin-top:20px;font-weight:bold;transition:.3s
}
.card a:hover{background:var(--dark)}

/* Depoimentos */
.testimonials{background:#f1f5f9}
.testimonial{
  background:#fff;padding:30px;border-radius:20px;
  box-shadow:0 4px 12px rgba(0,0,0,.05);font-style:italic
}
.stars{color:#f59e0b;margin-bottom:12px;font-size:1.2rem}

/* Formulário */
.lead-box{
  background:#fff;padding:50px;border-radius:24px;text-align:center;
  box-shadow:0 15px 35px rgba(0,0,0,0.1);border:1px solid #e2e8f0
}
form{max-width:600px;margin:35px auto 0;text-align:left}
label{font-weight:bold;display:block;margin-bottom:5px;color:var(--dark)}
input,textarea{
  width:100%;padding:14px;margin-bottom:20px;border:2px solid #e2e8f0;
  border-radius:10px;font-size:1rem;transition:.3s
}
input:focus,textarea:focus{border-color:var(--secondary);outline:none}
button{
  background:var(--secondary);color:#fff;border:none;padding:16px 30px;
  border-radius:10px;font-weight:bold;cursor:pointer;width:100%;font-size:1.1rem;transition:.3s
}
button:hover{background:var(--dark)}

footer{
  background:var(--dark);color:#fff;text-align:center;padding:40px 20px;font-size:0.95rem;opacity:0.9
}

/* Botão Flutuante */
.float{
  position:fixed;right:25px;bottom:25px;width:60px;height:60px;
  border-radius:50%;background:#25D366;color:#fff;
  display:flex;align-items:center;justify-content:center;
  text-decoration:none;font-size:30px;z-index:100;
  box-shadow:0 10px 25px rgba(37,211,102,0.4);transition:.3s
}
.float:hover{transform:scale(1.1)}

@media (max-width:768px){
  h1{font-size:2rem}
  .lead-box{padding:30px 20px}
}
</style>
</head>
